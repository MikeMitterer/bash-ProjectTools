msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de\n"

msgid "origin must refer to a GitHub repository."
msgstr "origin muss auf ein GitHub-Repository zeigen."

msgid "A README link leaves the repository: {path}"
msgstr "Ein README-Link verlässt das Repository: {path}"

msgid "Converted README exceeds {limit} UTF-8 bytes; nothing uploaded. Record the Docker Hub limit in your project's AGENTS.md and move long sections into linked documents."
msgstr "Das konvertierte README überschreitet {limit} UTF-8-Bytes; nichts hochgeladen. Verankere die Docker-Hub-Beschränkung in der AGENTS.md deines Projekts und lagere lange Abschnitte in verlinkte Dokumente aus."

msgid "Docker Hub returned HTTP {status}."
msgstr "Docker Hub antwortet mit HTTP {status}."

msgid "Docker Hub returned an invalid response."
msgstr "Docker Hub hat eine ungültige Antwort geliefert."

msgid "Repository must use the form namespace/name."
msgstr "Gib das Repository als namespace/name an."

msgid "Short description exceeds 100 bytes."
msgstr "Die Kurzbeschreibung überschreitet 100 Bytes."

msgid "Docker Hub readback differs from the uploaded description."
msgstr "Die zurückgelesene Beschreibung weicht vom Upload ab."

msgid "Publish the local README to Docker Hub."
msgstr "Übertrage das lokale README nach Docker Hub."

msgid "Write a preview without network access or credentials."
msgstr "Schreibe eine Vorschau ohne Netzwerkzugriff oder Zugangsdaten."

msgid "Upload the README and verify the saved description."
msgstr "Übertrage das README und prüfe die gespeicherte Beschreibung."

msgid "Docker Hub namespace/name; detected from project settings."
msgstr "Docker Hub namespace/name; aus Projekteinstellungen ermittelt."

msgid "Docker Hub user; defaults to the repository namespace."
msgstr "Docker-Hub-Benutzer; Vorgabe ist der Repository-Namespace."

msgid "Published GitHub branch or commit for links."
msgstr "Veröffentlichter GitHub-Branch oder Commit für Links."

msgid "Preview file; never the source README."
msgstr "Vorschaudatei; niemals das Quell-README."

msgid "Local token file; default follows DOCKER_PW_FILE / DOCKER_CONFIG."
msgstr "Lokale Token-Datei; Vorgabe folgt DOCKER_PW_FILE / DOCKER_CONFIG."

msgid "Optional short description; otherwise preserve the existing one."
msgstr "Optionale Kurzbeschreibung; sonst bleibt die bestehende erhalten."

msgid "--publish requires --repository."
msgstr "--publish benötigt --repository."

msgid "The preview must not overwrite README.md."
msgstr "Die Vorschau darf README.md nicht überschreiben."

msgid "Preview written: {path}"
msgstr "Vorschau geschrieben: {path}"

msgid "The token file is empty."
msgstr "Die Token-Datei ist leer."

msgid "Docker Hub description updated and verified: {repository}"
msgstr "Docker-Hub-Beschreibung aktualisiert und geprüft: {repository}"

msgid "Operation failed ({kind}); check Pandoc, the token file and connectivity."
msgstr "Aktion fehlgeschlagen ({kind}); prüfe Pandoc, die Token-Datei und die Verbindung."

msgid "The image was already pushed. Retry the README upload separately."
msgstr "Das Image wurde bereits gepusht. Wiederhole den README-Upload separat."

msgid "Project root; defaults to the current directory."
msgstr "Projektverzeichnis; Vorgabe ist das aktuelle Verzeichnis."

msgid "Source README, relative to the project root."
msgstr "Quell-README, relativ zum Projektverzeichnis."

msgid "GitHub owner/repository; defaults to origin."
msgstr "GitHub owner/repository; Vorgabe aus origin."

msgid "Pandoc is missing. Install it from https://pandoc.org/installing.html."
msgstr "Pandoc fehlt. Installiere es über https://pandoc.org/installing.html."

msgid "The project directory does not exist. Check --project-dir."
msgstr "Das Projektverzeichnis fehlt. Prüfe --project-dir."

msgid "Could not create .venv. Check Python's venv support and directory permissions."
msgstr "Die .venv konnte nicht angelegt werden. Prüfe die venv-Unterstützung von Python und die Verzeichnisrechte."

msgid "The tool .venv must be a working virtual environment with Python 3.11 or newer."
msgstr "Die Werkzeug-.venv muss eine funktionsfähige virtuelle Umgebung mit Python 3.11 oder neuer sein."

msgid "Could not install the README dependencies in .venv. Check pip and package-index access."
msgstr "Die README-Abhängigkeiten konnten nicht in .venv installiert werden. Prüfe pip und den Zugriff auf den Paketindex."

msgid "Start this tool through ProjectTools/src/bash/dockerhub-readme.sh to prepare .venv."
msgstr "Starte das Werkzeug über ProjectTools/src/bash/dockerhub-readme.sh, damit .venv eingerichtet wird."

msgid "The README must be inside the project directory."
msgstr "Das README muss im Projektverzeichnis liegen."

msgid "README is missing or unreadable. Check --project-dir and --readme."
msgstr "Das README fehlt oder ist nicht lesbar. Prüfe --project-dir und --readme."

msgid "Docker Hub token file is missing or unreadable. Set --token-file or DOCKER_PW_FILE."
msgstr "Die Docker-Hub-Token-Datei fehlt oder ist nicht lesbar. Setze --token-file oder DOCKER_PW_FILE."

msgid "Python 3.11 or newer is required. Set PYTHON_BOOTSTRAP to a suitable interpreter."
msgstr "Python 3.11 oder neuer ist erforderlich. Setze PYTHON_BOOTSTRAP auf einen passenden Interpreter."

msgid "The tool environment must not be a symlink. Check the ProjectTools cache directory."
msgstr "Die Werkzeugumgebung darf kein Symlink sein. Prüfe das ProjectTools-Cacheverzeichnis."

msgid "Actions"
msgstr "Aktionen"

msgid "Repository"
msgstr "Repository"

msgid "Files"
msgstr "Dateien"

msgid "Help"
msgstr "Hilfe"

msgid "Hints:"
msgstr "Beispiele:"

msgid "Show this help and exit."
msgstr "Zeige diese Hilfe und beende das Script."

msgid "%(prog)s [options]"
msgstr "%(prog)s [Optionen]"

msgid "Write a preview without Docker Hub access."
msgstr "Schreibe eine Vorschau ohne Docker-Hub-Zugriff."

msgid "GitHub links converted; size limit checked"
msgstr "GitHub-Links umgewandelt, Größenlimit geprüft"

msgid "Publish to Docker Hub"
msgstr "Auf Docker Hub veröffentlichen"

msgid "Default: %(default)s."
msgstr "Vorgabe: %(default)s."

msgid "Conflicting Docker image settings. Set --repository explicitly."
msgstr "Widersprüchliche Docker-Image-Einstellungen. Setze --repository ausdrücklich."

msgid "No unambiguous Docker Hub repository found. Set --repository namespace/name."
msgstr "Kein eindeutiges Docker-Hub-Repository gefunden. Setze --repository namespace/name."

msgid "Docker Hub returned HTTP {status} during {step}."
msgstr "Docker Hub antwortet bei {step} mit HTTP {status}."

msgid "Check the login user, repository access and token permissions (Read, Write, Delete for description updates)."
msgstr "Prüfe den Login-Benutzer, den Repository-Zugriff und die Token-Rechte (Read, Write, Delete für Beschreibungsänderungen)."

msgid "authentication (POST /v2/auth/token)"
msgstr "der Anmeldung (POST /v2/auth/token)"

msgid "description update (PATCH)"
msgstr "der Beschreibungsänderung (PATCH)"

msgid "verification (GET)"
msgstr "der Kontrolle durch Rücklesen (GET)"
